# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Clave de la API de Anthropic (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Token para entrar al panel web. Invéntate uno largo y difícil.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PANEL_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Puerto e interfaz del panel. 0.0.0.0 permite abrirlo desde el móvil
# en la misma red WiFi (http://IP-DE-TU-ORDENADOR:3000).
PORT=3000
HOST=0.0.0.0

# --- Vinculación de WhatsApp -----------------------------------------------
# Opción A (recomendada si gestionas desde el móvil): código de 8 letras.
# Pon aquí tu número con prefijo de país y SIN + ni espacios. Ej: 34600111222
# Luego en WhatsApp: Ajustes > Dispositivos vinculados > Vincular con número.
PAIRING_PHONE=

# Opción B: deja PAIRING_PHONE vacío y escanea el QR que aparece en la terminal.

# --- Modelos ---------------------------------------------------------------
# Clasificador (trabajo / personal). Se ejecuta en cada mensaje entrante.
# Si quieres abaratarlo, puedes usar claude-haiku-4-5 aquí.
CLASSIFIER_MODEL=claude-opus-5

# Redactor de borradores. Solo se ejecuta con mensajes ya marcados de trabajo.
DRAFTER_MODEL=claude-opus-5

# --- Comportamiento --------------------------------------------------------
# Segundos que espera tras el último mensaje antes de analizar la conversación.
# Evita generar un borrador por cada mensaje de una ráfaga.
DEBOUNCE_SECONDS=15

# Nº de mensajes recientes del chat que se pasan como contexto a la IA.
CONTEXT_MESSAGES=15

# Idioma por defecto de los borradores si no se detecta otro (es / en / ...).
DEFAULT_LANGUAGE=es

# Firma opcional que se añade al final de cada borrador (deja vacío para nada).
SIGNATURE=
